# Canonical public HTTPS origin used for confirmation links (also configure in Lovable Cloud Secrets).
APP_BASE_URL="https://rfbank.lovable.app"

# Public/browser-safe Supabase configuration only.
# Never commit secrets or service-role keys.
SUPABASE_PROJECT_ID=""
SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_URL=""
VITE_SUPABASE_PROJECT_ID=""
VITE_SUPABASE_PUBLISHABLE_KEY=""
VITE_SUPABASE_URL=""

# Server-only SMS provider configuration.
# Use Lovable Cloud Secrets for the real API key.
SMS_PROVIDER="africastalking"
SMS_PAYLOAD_ENCRYPTION_KEY="" # Base64-encoded 32-byte AES-256 key; required for OTP SMS
AFRICASTALKING_ENV="sandbox"
AFRICASTALKING_USERNAME="sandbox"
AFRICASTALKING_SENDER_ID="RFCBANK"
AFRICASTALKING_API_KEY=""
